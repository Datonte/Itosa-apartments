{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/browse",             "destination": "/browse.html" },
    { "source": "/booking",            "destination": "/booking.html" },
    { "source": "/confirmation",       "destination": "/confirmation.html" },
    { "source": "/contact",            "destination": "/contact.html" },
    { "source": "/faq",                "destination": "/faq.html" },
    { "source": "/terms",              "destination": "/terms.html" },
    { "source": "/refund",             "destination": "/refund.html" },
    { "source": "/admin",              "destination": "/admin-dashboard.html" },
    { "source": "/admin-dashboard",    "destination": "/admin-dashboard.html" },
    { "source": "/admin-apartments",   "destination": "/admin-apartments.html" },
    { "source": "/admin-bookings",     "destination": "/admin-bookings.html" },
    { "source": "/admin-availability", "destination": "/admin-availability.html" },
    { "source": "/apartments/:slug",   "destination": "/details.html" }
  ],
  "redirects": [
    { "source": "/index",   "destination": "/",       "permanent": true },
    { "source": "/details", "destination": "/browse", "permanent": false },
    { "source": "/apartments/surulere-1-bedroom", "destination": "/apartments/surulere-ground-floor", "permanent": false },
    { "source": "/apartments/isheri-2-bedroom",   "destination": "/apartments/isheri-ivie-home",      "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin-(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
